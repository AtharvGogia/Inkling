<Window x:Class="Inkling.Ui.Wpf.WelcomeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Inkling"
        Width="640" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">
    <StackPanel Margin="28,24,28,24">
        <DockPanel>
            <Image x:Name="Logo" Width="56" Height="56" DockPanel.Dock="Left" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to Inkling" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Answers where you type." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border CornerRadius="8" Padding="14" Margin="0,20,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="How it works" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="Step1" TextWrapping="Wrap" />
                <TextBlock Text="     find files over 100mb in home   ⏎     →     find ~ -type f -size +100M" FontFamily="Consolas" Opacity="0.85" Margin="0,8,0,8" TextWrapping="Wrap" />
                <TextBlock x:Name="Step2" TextWrapping="Wrap" />
                <TextBlock x:Name="Step3" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="Nothing is ever run for you. Esc cancels." TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="NVIDIA API key" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Save and test" Click="SaveKey_Click" Margin="8,0,0,0" />
            <PasswordBox x:Name="KeyBox" ToolTip="Paste your key (starts with nvapi-)" />
        </DockPanel>
        <WrapPanel Margin="0,8,0,0">
            <Button Content="Test the current key" Click="Test_Click" Margin="0,0,10,0" />
            <TextBlock x:Name="TestResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </WrapPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0">
            <Hyperlink Click="Nvidia_Click">Get a free key</Hyperlink><Run Text=" · stored in Windows Credential Manager" />
        </TextBlock>

        <CheckBox x:Name="StartupCheck" Content="Start when I sign in to Windows" Margin="0,22,0,0" />
        <CheckBox x:Name="RiskCheck" Content="Ask before typing risky commands" Margin="0,4,0,0" />
        <TextBlock Text="Everything else is in Settings: click the tray icon." Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Open Settings" Click="Settings_Click" Margin="0,0,8,0" />
            <Button Content="Get started" Click="Done_Click" IsDefault="True" MinWidth="110" />
        </StackPanel>
    </StackPanel>
</Window>
