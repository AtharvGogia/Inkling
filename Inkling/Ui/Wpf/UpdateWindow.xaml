<Window x:Class="Inkling.Ui.Wpf.UpdateWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inkling update"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">
    <StackPanel Margin="24">
        <DockPanel>
            <Image x:Name="Logo" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="Subheading" Opacity="0.7" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,18,0,6" />
        <Border CornerRadius="6" Padding="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notes" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" Visibility="Collapsed" Maximum="1" />
        <TextBlock x:Name="Status" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0" />
        <DockPanel Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                <Hyperlink Click="Page_Click">Release page</Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip this version" Click="Skip_Click" Margin="0,0,8,0" />
                <Button Content="Later" Click="Later_Click" Margin="0,0,8,0" />
                <Button x:Name="InstallButton" Content="Update now" Click="Install_Click" IsDefault="True" MinWidth="110" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
