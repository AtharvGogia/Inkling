<Window x:Class="Inkling.Ui.Wpf.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Inkling.Ui.Wpf"
        Title="Inkling settings"
        Width="860" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <Image x:Name="Wordmark" Height="46" HorizontalAlignment="Left" Stretch="Uniform" />
                <TextBlock Text="Answers where you type." Style="{StaticResource Hint}" Margin="0,8,0,0" />

                <Border CornerRadius="8" Padding="12" Margin="0,20,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="StatusModel" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusKey" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatusHotkeys" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                    <Run Text="By Atharv Gogia · " /><Hyperlink Click="Source_Click">GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="32,0,0,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Reset to defaults" Click="Reset_Click" Margin="0,0,8,0"
                        ToolTip="Keeps your API key, snippets, app lists and start-at-sign-in." />
                <Button Content="Done" Click="Done_Click" IsDefault="True" MinWidth="96" />
            </StackPanel>

            <TabControl x:Name="Tabs" Height="500">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Shortcuts" Style="{StaticResource Section}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ask" VerticalAlignment="Center" />
                                <local:HotkeyBox x:Name="AskHotkey" Grid.Column="1" HorizontalAlignment="Left" Width="220" />
                                <TextBlock x:Name="AskProblem" Grid.Row="1" Grid.Column="1" Foreground="#E0A030" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed" />

                                <TextBlock Grid.Row="2" Text="Ask about selection" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <local:HotkeyBox x:Name="SelectionHotkey" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="220" AllowEmpty="True" Margin="0,8,0,0" />
                                <TextBlock x:Name="SelectionProblem" Grid.Row="3" Grid.Column="1" Foreground="#E0A030" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed" />

                                <TextBlock Grid.Row="4" Text="Try again" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <local:HotkeyBox x:Name="RetryHotkey" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Width="220" AllowEmpty="True" Margin="0,8,0,0" />
                                <TextBlock x:Name="RetryProblem" Grid.Row="5" Grid.Column="1" Foreground="#E0A030" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Text="Click a box, then press the keys. Backspace turns one off." Style="{StaticResource Hint}" Margin="0,8,0,0" />

                            <TextBlock Text="Answer length" Style="{StaticResource Section}" />
                            <RadioButton x:Name="LengthShort" Content="Short: a word or a command" GroupName="Length" />
                            <RadioButton x:Name="LengthSentence" Content="A sentence or two" GroupName="Length" Margin="0,4,0,0" />
                            <RadioButton x:Name="LengthParagraph" Content="A paragraph" GroupName="Length" Margin="0,4,0,0" />

                            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                            <WrapPanel>
                                <RadioButton x:Name="ThemeSystem" Content="Same as Windows" GroupName="Theme" MinWidth="0" Margin="0,0,20,0" />
                                <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" MinWidth="0" Margin="0,0,20,0" />
                                <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" MinWidth="0" />
                            </WrapPanel>

                            <CheckBox x:Name="StartupCheck" Content="Start when I sign in to Windows" Margin="0,22,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Model">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Model" Style="{StaticResource Section}" />
                            <StackPanel x:Name="ModelList" />

                            <TextBlock Text="NVIDIA API key" Style="{StaticResource Section}" />
                            <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save" Click="SaveKey_Click" Margin="8,0,0,0" />
                                <PasswordBox x:Name="KeyBox" ToolTip="nvapi-…" />
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Test" Click="TestKey_Click" Margin="0,0,8,0" />
                                <Button x:Name="RemoveKeyButton" Content="Remove" Click="RemoveKey_Click" Margin="0,0,12,0" />
                                <TextBlock x:Name="TestResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                <Hyperlink Click="NvidiaKey_Click">Get a free key</Hyperlink><Run Text=" · stored in Windows Credential Manager" />
                            </TextBlock>

                            <Expander Header="Use a command-line tool instead" Margin="0,24,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <RadioButton x:Name="BackendNim" Content="NVIDIA API" GroupName="Backend" />
                                    <RadioButton x:Name="BackendClaude" GroupName="Backend" Margin="0,4,0,0" />
                                    <RadioButton x:Name="BackendAgy" GroupName="Backend" Margin="0,4,0,0" />
                                    <Button Content="Restart the CLI" Click="ClearContext_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Typing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="While waiting" Style="{StaticResource Section}" />
                            <RadioButton x:Name="IndicatorIcon" Content="“i__rdy” in the top-left corner" GroupName="Indicator" />
                            <RadioButton x:Name="IndicatorBar" Content="Bar next to the cursor" GroupName="Indicator" Margin="0,4,0,0" />
                            <CheckBox x:Name="DotsCheck" Content="Animate “...” in the text field" Margin="0,10,0,0" />

                            <TextBlock Text="Typing speed" Style="{StaticResource Section}" />
                            <DockPanel>
                                <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Pause between keys" />
                            </DockPanel>
                            <TextBlock Text="Slower in these apps" Margin="0,14,0,4" />
                            <DockPanel>
                                <TextBlock x:Name="SlowSpeedText" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="SlowSpeedSlider" Minimum="10" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" />
                            </DockPanel>
                            <local:AppListEditor x:Name="SlowApps" Margin="0,6,0,0" />

                            <CheckBox x:Name="SingleLineCheck" Content="Keep answers on one line" Margin="0,22,0,0"
                                      ToolTip="In a terminal, a line break would run the command." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Snippets">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Snippets" Style="{StaticResource Section}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Ask for a snippet and it's typed instantly, without the model. {date}, {time} and {clipboard} are filled in." />
                            <local:SnippetEditor x:Name="SnippetList" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Privacy">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Risky commands" Style="{StaticResource Section}" />
                            <CheckBox x:Name="RiskCheck" Content="Ask before typing one" />
                            <TextBlock Text="rm -rf, DROP TABLE, git reset --hard and the like. Enter types it, Esc doesn't." Style="{StaticResource Hint}" Margin="28,2,0,0" />

                            <TextBlock Text="Turned off in" Style="{StaticResource Section}" />
                            <local:AppListEditor x:Name="DisabledApps" />

                            <TextBlock Text="Sent with each request" Style="{StaticResource Section}" />
                            <CheckBox x:Name="TitleCheck" Content="The window title" />
                            <TextBlock Text="Helps answers fit (the folder in a terminal, the file in an editor). Your request and the app's name are always sent. Nothing you type is logged." Style="{StaticResource Hint}" Margin="28,2,0,0" />
                            <CheckBox x:Name="OpenItemCheck" Content="The page address or the open file's name" Margin="0,10,0,0" />
                            <TextBlock Text="In a browser, the site and page (never the part after ? or #). In other apps, the file's name, never its folder. Never sent from private windows." Style="{StaticResource Hint}" Margin="28,2,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="About">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Updates" Style="{StaticResource Section}" />
                            <CheckBox x:Name="UpdatesCheck" Content="Check for updates automatically" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CheckNowButton" Content="Check now" Click="CheckUpdates_Click" Margin="0,0,12,0" />
                                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                            </WrapPanel>

                            <TextBlock Text="Help" Style="{StaticResource Section}" />
                            <WrapPanel>
                                <Button Content="Tutorial" Click="Tutorial_Click" Margin="0,0,8,8" />
                                <Button Content="Welcome guide" Click="Welcome_Click" Margin="0,0,8,8" />
                                <Button Content="Request timings" Click="Timings_Click" Margin="0,0,8,8" />
                                <Button Content="Open log" Click="OpenLog_Click" Margin="0,0,8,8" />
                                <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,8,8"
                                        ToolTip="Settings and recent log lines, for a bug report. Never your key or what you typed." />
                                <TextBlock x:Name="CopiedText" Text="Copied." VerticalAlignment="Center" Opacity="0.7" Visibility="Collapsed" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                                <Hyperlink Click="Issues_Click">Report a bug or suggest something</Hyperlink>
                            </TextBlock>

                            <TextBlock Text="Advanced" Style="{StaticResource Section}" />
                            <TextBlock Text="The prompt, example answers and per-app hints live in config.json." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Open config.json" Click="OpenConfig_Click" Margin="0,0,8,0" />
                                <Button Content="Open folder" Click="OpenFolder_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
