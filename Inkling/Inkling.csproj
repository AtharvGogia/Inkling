<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF for the Settings and Welcome windows (Windows 11 Fluent look, like Circularity). -->
    <UseWPF>true</UseWPF>
    <!-- WPF0001: Window.ThemeMode (Fluent) is marked experimental. WFO0003: DPI mode comes from the WinForms API. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Inkling</AssemblyName>
    <RootNamespace>Inkling</RootNamespace>
    <Product>Inkling</Product>
    <ApplicationIcon Condition="Exists('Assets/inkling.ico')">Assets/inkling.ico</ApplicationIcon>
    <Version>0.4.5</Version>
    <Authors>Atharv Gogia</Authors>
    <Company>Atharv Gogia</Company>
    <Description>Type a request anywhere in Windows and get a short AI answer in its place.</Description>
    <Copyright>© 2026 Atharv Gogia</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inkling.Tests" />
  </ItemGroup>

</Project>
